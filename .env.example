# Optional deployment settings. Do not commit the real .env file.
# Set a stable random salt of at least 32 characters, or the runner generates
# one in ../.episcope-secrets/patient-salt, outside this repository.
EPISCOPE_SALT=
EPISCOPE_DRIVER_MEMORY=1g
EPISCOPE_SPARK_MASTER=local[2]
EPISCOPE_SHUFFLE_PARTITIONS=8
EPISCOPE_VENV=/tmp/episcope_venv
